# Kairacure CI/CD Environment Variables
# Used by deploy.yml, rollback.yml (GitHub Actions)
# All configured via GitHub Secrets — no .env file needed in the repo.

# GitHub Actions OIDC (automatically handled by aws-actions/configure-aws-credentials)
# No secrets required — uses id-token: write permission + IAM role trust policy

# AWS Configuration (set in workflow env vars, not secrets)
AWS_REGION=ap-south-1
EC2_INSTANCE=i-048117c391049faa7

# IAM Role (hardcoded in workflows)
# arn:aws:iam::987119352718:role/kairacure-github-deploy

# S3 Buckets
# s3://kairacure-artifacts-prod/backend/    (deployment artifacts)
# s3://kairacure-web-prod/                  (web frontend)
# s3://kairacure-admin-prod/                (admin frontend)

# EC2 Target
# Instance: i-048117c391049faa7
# Deploy path: /opt/kairacure
# App port: 5000
