# Backend API Server Configuration
PORT=5000
NODE_ENV=development

# Database Connections
MONGODB_PUBLIC_URI=mongodb+srv://user:pass@cluster.mongodb.net/kairacure_public
MONGODB_PATIENT_RECORDS_URI=mongodb+srv://user:pass@cluster.mongodb.net/kairacure_patient_records

# CORS & Allowed Origins
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,https://admin.kairacure.com,https://kairacure.com

# Security & Encryption Secrets
JWT_ACCESS_SECRET=your_rsa_or_sha256_jwt_access_secret_32chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_32chars
AES_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AWS Private Storage & KMS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_PRIVATE_DOCS_BUCKET=kairacure-private-patient-docs-prod
AWS_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/your-kms-key-id
